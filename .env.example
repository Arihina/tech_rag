# --- Postgres ---
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=techdocs_rag_db

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_COLLECTION=techdocs_hybrid

# --- Модели ---
EMBED_MODEL=BAAI/bge-m3
# cpu | cuda | cuda:0 | mps. CPU по умолчанию: GPU нужен Ollama,
# bge-m3 на CPU кодирует запрос за ~0.2-0.3 с.
EMBED_DEVICE=cpu
OLLAMA_MODEL=gemma2:9b
OLLAMA_HOST=http://localhost:11434

# --- Генерация и контекст ---
ALLOW_GENERAL_ANSWER=false
OLLAMA_NUM_CTX=8192
MAX_CONTEXT_CHARS=12000
HISTORY_MAX_CHARS=4000
HISTORY_LIMIT=10

# --- Внутренняя аутентификация master -> агент ---
ENV=dev
# off | token | assertion. В проде — только token (assertion — этап 2).
INTERNAL_AUTH_MODE=token
AGENT_ID=tech_rag
# Per-agent секрет, выданный master (AGENT_INTERNAL_TOKENS["tech_rag"]).
# НЕ коммитить реальное значение — оно хранится только в .env/secret.
MASTER_INTERNAL_TOKEN=
